# Copy to .env and adjust. All values are optional.
# SQLite file (absolute or relative URL). Default: data/wind_turbine.db
# WTA_DATABASE_URL=sqlite:///C:/path/to/wind_turbine.db
# WTA_DATA_DIR=data
# WTA_REPORTS_DIR=reports
# WTA_POWERBI_DIR=powerbi/datasets
WTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WTA_RANDOM_SEED=42
# Frontend (frontend/.env): leave empty to use the Vite dev proxy
# VITE_API_BASE_URL=
